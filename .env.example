# Required: use two distinct, long, randomly generated secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# API and frontend URLs
PORT=3000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# PostgreSQL connection
DB_DATABASE=rah
DB_HOST=localhost
DB_PORT=6000
DB_USER=replace-with-database-user
DB_PASS=replace-with-a-strong-database-password

# Required to send verification and password-reset emails.
# Gmail: create an App Password, then use smtp.gmail.com and port 465.
# Never put your normal Gmail password here or commit your real .env file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
